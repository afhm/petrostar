---
import ImageComp from './ImageComp.astro';

const navigation = [
  { title: 'Home', link: '/' },
  { title: 'About', link: '/about' },
  { title: 'Services', link: '/services' },
  { title: 'Contact', link: '/contact' },
];

// Mark the current page so the active state survives a direct visit or a hash link.
const path = Astro.url.pathname.replace(/\/+$/, '') || '/';
---

<header id="header">
  <div class="wpo-site-header wpo-site-header-s4">
    <nav class="navigation navbar navbar-expand-lg navbar-light">
      <div class="container-fluid">
        <div class="row align-items-center">
          <div class="col-lg-3 col-md-3 col-3 d-lg-none dl-block">
            <div class="mobail-menu">
              <button type="button" class="navbar-toggler open-btn">
                <span class="sr-only">Toggle navigation</span>
                <span class="icon-bar first-angle"></span>
                <span class="icon-bar middle-angle"></span>
                <span class="icon-bar last-angle"></span>
              </button>
            </div>
          </div>
          <div class="col-lg-2 col-md-6 col-6">
            <div class="navbar-header">
              <a class="navbar-brand" href="/">
                <ImageComp imagePath="/src/images/Petrostar White Orange.png" className="logo inline" altText="Petrostar Innovative" />
              </a>
            </div>
          </div>
          <div class="col-lg-7 col-md-1 col-1">
            <div id="navbar" class="collapse navbar-collapse navigation-holder !justify-center">
              <button class="menu-close"><i class="ti-close"></i></button>
              <ul class="nav navbar-nav mb-lg-0 mb-2">
                {
                  navigation.map((item) => (
                    <li>
                      <a href={item.link} class={path === item.link ? 'active' : undefined}>
                        {item.title}
                      </a>
                    </li>
                  ))
                }
              </ul>
            </div><!-- end of nav-collapse -->
          </div>
          <div class="col-lg-3 col-md-2 col-2">
            <div class="header-right">
              <div class="header-search-form-wrapper">
                <div class="cart-search-contact">
                  <button class="search-toggle-btn"><i class="fi flaticon-loupe"></i></button>
                  <div class="header-search-form">
                    <form>
                      <div>
                        <input type="text" class="form-control" placeholder="Search here..." />
                        <button type="submit"><i class="fi flaticon-loupe"></i></button>
                      </div>
                    </form>
                  </div>
                </div>
              </div>
              <div class="close-form">
                <a class="theme-btn" href="/contact">Get In Touch</a>
              </div>
            </div>
          </div>
        </div>
      </div><!-- end of container -->
    </nav>
  </div>
</header>
