---
import ServiceCard from './ServiceCard.astro';
import { services } from '@data/services';

interface Props {
  /**
   * 'carousel' is the homepage Owl slider. 'grid' is a static layout, used on
   * /services so the per-service anchor links have a stable, unique target.
   */
  layout?: 'carousel' | 'grid';
}

const { layout = 'carousel' } = Astro.props;
const isGrid = layout === 'grid';
---

<section class="wpo-service-section section-padding" id="services">
  <div class="service-wrap">
    <div class="wpo-section-title">
      <h2>What We Offer</h2>
      <h3>Products & Services</h3>
    </div>
    <div class:list={['service-slider', isGrid ? 'service-grid' : 'owl-carousel']}>
      {services.map((service) => <ServiceCard {...service} anchorId={isGrid ? service.slug : undefined} />)}
    </div>
  </div>
</section>

<style>
  /* Static layout: no Owl, so the ids stay unique and #anchor links land. */
  .service-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 30px;
  }

  /* Clear the fixed site header when jumping to a service anchor. */
  .service-grid :global(.item) {
    scroll-margin-top: 140px;
  }

  @media (max-width: 767px) {
    .service-grid {
      grid-template-columns: 1fr;
    }

    .service-grid :global(.item) {
      scroll-margin-top: 90px;
    }
  }
</style>
