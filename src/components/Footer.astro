---
import ImageComp from './ImageComp.astro';
import { services, serviceUrl } from '@data/services';

const navigation = [
  { title: 'Home', link: '/' },
  { title: 'About', link: '/about' },
  { title: 'Services', link: '/services' },
  { title: 'Contact', link: '/contact' },
];

// TODO: swap these for the real profile URLs once the accounts are confirmed.
const socials = [
  { label: 'Facebook', icon: 'ti-facebook', link: '/contact' },
  { label: 'Twitter', icon: 'ti-twitter-alt', link: '/contact' },
  { label: 'Instagram', icon: 'ti-instagram', link: '/contact' },
  { label: 'LinkedIn', icon: 'ti-linkedin', link: '/contact' },
];
---

<!-- start of wpo-site-footer-section -->
<footer class="wpo-site-footer">
  <div class="wpo-upper-footer">
    <div class="container">
      <div class="row">
        <div class="col col-lg-3 col-md-6 col-sm-12 col-12">
          <div class="widget about-widget">
            <div class="logo widget-title">
              <a href="/">
                <ImageComp imagePath="/src/images/Petrostar-Colour-Logo.png" className="inline" altText="Petrostar Innovative" />
              </a>
            </div>
            <p>
              Providing innovative solutions and services across various industries, ensuring quality and reliability.
            </p>
            <div class="social-widget">
              <ul>
                {
                  socials.map((social) => (
                    <li>
                      <a href={social.link} aria-label={social.label}>
                        <i class={social.icon} />
                      </a>
                    </li>
                  ))
                }
              </ul>
            </div>
          </div>
        </div>

        <div class="col col-lg-3 col-md-6 col-sm-12 col-12">
          <div class="widget link-widget">
            <div class="widget-title">
              <h3>Our Services</h3>
            </div>
            <ul>
              {
                services.map((service) => (
                  <li>
                    <a href={serviceUrl(service.slug)}>{service.title}</a>
                  </li>
                ))
              }
            </ul>
          </div>
        </div>

        <div class="col col-lg-3 col-md-6 col-sm-12 col-12">
          <div class="widget link-widget">
            <div class="widget-title">
              <h3>Navigation</h3>
            </div>
            <ul>
              {
                navigation.map((item) => (
                  <li>
                    <a href={item.link}>{item.title}</a>
                  </li>
                ))
              }
            </ul>
          </div>
        </div>

        <div class="col col-lg-3 col-md-6 col-sm-12 col-12">
          <div class="widget newsletter-widget">
            <div class="widget-title">
              <h3>Newsletter</h3>
            </div>
            <p>Get latest updates and offers</p>
            <div class="email-from">
              <input class="fild" type="text" placeholder="Your email" />
              <button type="reset"><i class="ti-arrow-top-right"></i></button>
            </div>
          </div>
        </div>
      </div>
    </div>
    <!-- end container -->
  </div>
  <div class="wpo-lower-footer">
    <div class="container">
      <div class="row">
        <div class="col col-xs-12">
          <p class="copyright">
            Copyright © Petrostar Innovative 2024 <br /> Developed by
            <a href="https://alifsense.com" target="_blank" rel="noopener noreferrer" title="AlifSense">AlifSense</a>
            All Rights Reserved.
          </p>
        </div>
      </div>
    </div>
  </div>
</footer>
